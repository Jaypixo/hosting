# Shared
NODE_ENV=development

# Dashboard
WEB_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_ROOT_DOMAIN=myhosting.com

# API
API_PORT=4000
API_BASE_URL=http://localhost:4000
JWT_SECRET=replace-with-a-long-random-string
CORS_ORIGIN=http://localhost:3000

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hosting

# Redis
REDIS_URL=redis://localhost:6379

# GitHub OAuth
GITHUB_CLIENT_ID=your-github-oauth-app-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-app-client-secret
GITHUB_CALLBACK_URL=http://localhost:4000/auth/github/callback

# GitHub app webhook verification
GITHUB_WEBHOOK_SECRET=replace-with-a-long-random-string

# Build worker
BUILDER_SANDBOX_ROOT=./tmp/builds
BUILDER_GIT_BIN=git
BUILDER_NPM_BIN=npm

# Cloudflare R2 / S3-compatible
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=your-bucket-name
R2_ENDPOINT=
R2_PUBLIC_BASE_URL=
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id

# Cloudflare Worker edge router
EDGE_API_BASE_URL=http://localhost:4000
EDGE_API_SECRET=replace-with-a-long-random-string
EDGE_ROOT_DOMAIN=myhosting.com
EDGE_KV_NAMESPACE_ID=

# Local MinIO fallback for storage testing
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=http://localhost:9000
